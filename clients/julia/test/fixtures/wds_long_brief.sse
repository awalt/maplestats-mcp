data: {"jsonrpc":"2.0","id":11,"result":{"content":[{"text":"{\"series\":[{\"product_id\":14100287,\"coordinate\":\"1.7.1.1.1.1.0.0.0.0\",\"vector_id\":2062815,\"context\":{\"citation\":\"Statistics Canada. Table 14-10-0287-01, Labour force characteristics, monthly, seasonally adjusted and trend-cycle. Vector v2062815. Released 2026-11-06.\",\"table_id\":\"14-10-0287-01\",\"table_url\":\"https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410028701\",\"series_title\":\"Canada;Unemployment rate;Total - Gender;15 years and over;Estimate;Seasonally adjusted\",\"unit\":\"Percent\",\"scale\":\"units\",\"frequency\":\"Monthly\",\"geography\":\"Canada\",\"first_period\":\"1976-01-01\",\"last_period\":\"2026-10-01\"},\"observations\":{\"format\":\"csv\",\"rows\":12,\"csv\":\"ref_period,value\\n2025-11-01,6.5\\n2025-12-01,6.6\\n2026-01-01,6.8\\n2026-02-01,6.9\\n2026-03-01,6.9\\n2026-04-01,6.8\\n2026-05-01,6.7\\n2026-06-01,6.6\\n2026-07-01,6.5\\n2026-08-01,6.4\\n2026-09-01,6.5\\n2026-10-01,6.7\\n\"}}],\"provenance\":{\"source\":\"statcan-wds\",\"url\":\"https://www150.statcan.gc.ca/t1/wds/rest/getDataFromVectorsAndLatestNPeriods\",\"licence\":\"Statistics Canada Open Licence (https://www.statcan.gc.ca/en/reference/licence)\",\"commercial_use\":\"allowed\",\"caveats\":[\"LFS (people employed) and SEPH (payroll jobs, no self-employed) are different measures: do not compare their levels; compare trends over several months. For detailed-industry earnings use SEPH (14-10-0203, 14-10-0204).\",\"LFS figures are survey estimates with sampling error: a change is significant at 5% only if it is more than two standard errors from zero (standard errors are in 14-10-0287's Statistics dimension). Seasonally adjusted series are revised yearly.\"]},\"detail\":\"brief: detail='full' gives every field and whole caveats.\"}","type":"text"}],"isError":false,"structuredContent":{"series":[{"product_id":14100287,"coordinate":"1.7.1.1.1.1.0.0.0.0","vector_id":2062815,"context":{"citation":"Stati